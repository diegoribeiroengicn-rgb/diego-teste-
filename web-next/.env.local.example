# Copie para .env.local (nunca commitado — já está no .gitignore) e
# preencha com a connection string do MESMO Supabase já migrado do GAT —
# use o "Transaction pooler", não "Direct connection" (exige IPv6, falha
# na Vercel e no Streamlit Cloud).
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Chave usada para assinar a sessão de login (JWT) — qualquer string longa
# e aleatória, gere uma nova com: openssl rand -base64 32
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
